<h1 class="page-title page-header">Revisão do Tile <%= @tile.id %></h1>

<div class="row">
  <div class="col-12">
    <h4>Tile e Marcações</h4>
    <% preview_available = @tile.storage_path.present? && File.exist?(@tile.storage_path) %>
    <% if preview_available && defined?(ZenPlot) %>
      <%= zen_plot_assets %>

      <style>
        html {
          overflow-y: visible !important;
          height: auto !important;
        }

        body {
          overflow-y: auto !important;
          height: auto !important;
        }

        .reviewer-plot-readonly .canvas-panel {
          overflow-y: visible !important;
        }

        .reviewer-zoom-controls {
          display: flex;
          justify-content: flex-start;
          align-items: center;
          flex-wrap: wrap;
          gap: 0.5rem;
          margin-bottom: 0.75rem;
        }

        .reviewer-zoom-controls .reviewer-toolbar-left {
          display: flex;
          align-items: center;
          gap: 0.5rem;
          flex-wrap: wrap;
          margin-right: 0.75rem;
        }

        .reviewer-zoom-controls .reviewer-toolbar-left .control-group {
          margin-bottom: 0;
        }

        .reviewer-zoom-controls .reviewer-toolbar-meta {
          display: flex;
          flex-wrap: wrap;
          gap: 0.75rem;
          color: #495057;
          font-size: 0.9rem;
          margin-right: auto;
        }

        .reviewer-zoom-controls .reviewer-toolbar-meta strong {
          font-weight: 600;
        }

        .reviewer-zoom-controls .reviewer-action-buttons {
          display: flex;
          gap: 0.5rem;
          align-items: stretch;
        }

        .reviewer-zoom-controls .btn {
          width: 2.25rem;
          height: 2.25rem;
          padding: 0;
          display: inline-flex;
          align-items: center;
          justify-content: center;
        }

        .reviewer-zoom-controls .btn i {
          pointer-events: none;
        }

        .reviewer-zoom-label {
          font-size: 0.9rem;
          color: #6c757d;
          margin-bottom: 0;
        }

        .reviewer-zoom-icon {
          width: 18px;
          height: 18px;
          display: block;
        }

        .reviewer-action-buttons .btn {
          min-height: 2.5rem;
          line-height: 1.2;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          width: auto;
          height: auto;
          padding: 0.5rem 1rem;
        }
      </style>

      <main class="minimal-app reviewer-plot-readonly"
            data-wpd-app
            <% if @editable %>data-controller="alternate-point" data-action="contextmenu->alternate-point#handle"<% end %>
            data-wpd-default-image="<%= preview_tile_path(@tile) %>"
            data-wpd-default-points="<%= zen_plot_points_tile_path(@tile, format: :json) %>"
            data-review-editable="<%= @editable %>"
            data-review-points="<%= @editor_points.to_json %>"
            data-review-original-count="<%= @correction ? @correction.original_points.size : @editor_points.size %>"
            data-review-version="<%= @correction&.lock_version %>"
            data-review-claim-url="<%= claim_reviewer_review_path(@tile, format: :json) %>"
            data-review-save-url="<%= points_reviewer_review_path(@tile, format: :json) %>">
        <div class="wpd-loading-curtain" data-wpd-loading-curtain>
          Carregando plot...
        </div>

        <div class="minimal-controls reviewer-zoom-controls">
          <div class="reviewer-toolbar-left">
            <div class="reviewer-zoom-only">
              <%= render "zen_plot/pages/control_zoom" %>
            </div>
            <% if @editable %>
              <div class="control-group">
                <span class="control-label">Modo</span>
                <button type="button" data-wpd-add-point class="pressed-button">Marcar</button>
                <button type="button" data-wpd-delete-point>Apagar</button>
              </div>
            <% end %>
          </div>

          <div class="reviewer-toolbar-meta">
            <span><strong>Pontos marcados:</strong> <span data-review-count><%= @editor_points.size %></span></span>
            <span><strong>Estimativa:</strong> <%= @tile.head_count.present? ? @tile.head_count : '-' %></span>
            <% if @editable || @correction %>
              <span>Adicionados: <span data-review-added><%= @correction&.added_count.to_i %></span></span>
              <span>Apagados: <span data-review-removed><%= @correction&.removed_count.to_i %></span></span>
            <% end %>
          </div>

          <% if @editable %>
            <div class="reviewer-action-buttons">
              <%= link_to 'Voltar',
                          reviewer_reviews_path,
                          class: 'btn btn-outline-secondary py-2',
                          data: { turbo: false } %>
              <button type="button" class="btn btn-outline-primary" data-review-save disabled>Salvar</button>
              <%= button_to 'Aprovar',
                            approve_tile_path(@tile),
                            method: :post,
                            class: 'btn btn-success py-2',
                            disabled: true,
                            form: { class: 'm-0', data: { turbo: false, review_decision: true } } %>
              <%= button_to 'Reprovar',
                            reject_tile_path(@tile),
                            method: :post,
                            class: 'btn btn-danger py-2',
                            disabled: true,
                            form: { class: 'm-0', data: { turbo: false, review_decision: true } } %>
            </div>
          <% end %>
        </div>

        <%= render "zen_plot/pages/workspace", show_zoom_panel: true %>
      </main>
      <div class="alert alert-secondary mt-2" role="status" aria-live="polite" data-review-feedback>
        <% if @correction && @correction.reviewer_id != current_user.id && %w[submitted in_review].include?(@tile.status) %>
          Este envio está sendo revisado por outra pessoa.
        <% elsif !current_user.reviewer? && %w[submitted in_review].include?(@tile.status) %>
          Para editar, personifique o papel de revisor.
        <% elsif @editable %>
          Carregando marcações...
        <% else %>
          Visualização somente leitura.
        <% end %>
      </div>

      <script>
        (function() {
          function mountReviewerReadOnlyPlot() {
            var root = document.querySelector('[data-wpd-app]');
            if (!root) {
              return;
            }

            if (window.wpd) {
              if (!root.__wpdMinimalApp && typeof window.wpd.mountMinimalApp === 'function') {
                window.wpd.mountMinimalApp(root);
              } else if (!root.__wpdMinimalApp && typeof window.wpd.initMinimalApps === 'function') {
                window.wpd.initMinimalApps();
              }
            }

            if (!root.__wpdMinimalApp) {
              var retryCount = Number(root.dataset.wpdInitRetryCount || '0');
              if (retryCount < 25) {
                root.dataset.wpdInitRetryCount = String(retryCount + 1);
                setTimeout(mountReviewerReadOnlyPlot, 80);
              }
              return;
            }

            function positionZoomPanelWithinContainer() {
              var zoomPanel = root.querySelector('.zoom-panel');
              if (!zoomPanel || zoomPanel.dataset.initialPlacementDone === 'true') {
                return;
              }

              if (window.getComputedStyle(zoomPanel).position !== 'fixed') {
                return;
              }

              var rootRect = root.getBoundingClientRect();
              var panelWidth = zoomPanel.offsetWidth || 220;
              var viewportPadding = 12;
              var top = Math.round(rootRect.top + 150);
              var left = Math.round(rootRect.right - panelWidth - 50);

              top = Math.max(viewportPadding, Math.min(top, window.innerHeight - 140));
              left = Math.max(viewportPadding, Math.min(left, window.innerWidth - panelWidth - viewportPadding));

              zoomPanel.style.top = top + 'px';
              zoomPanel.style.left = left + 'px';
              zoomPanel.style.right = 'auto';
              zoomPanel.style.bottom = 'auto';
              zoomPanel.dataset.initialPlacementDone = 'true';
            }

            requestAnimationFrame(positionZoomPanelWithinContainer);
            setTimeout(positionZoomPanelWithinContainer, 120);

            if (root.dataset.wpdReadOnlyBound === 'true') {
              return;
            }

            root.dataset.wpdReadOnlyBound = 'true';

            function setupNativeZoomIcons() {
              var zoomButtons = root.querySelectorAll('.reviewer-zoom-only .control-group button, .reviewer-zoom-only .control-group .btn');
              if (!zoomButtons || zoomButtons.length < 2) {
                var zoomRetryCount = Number(root.dataset.wpdZoomRetryCount || '0');
                if (zoomRetryCount < 20) {
                  root.dataset.wpdZoomRetryCount = String(zoomRetryCount + 1);
                  setTimeout(setupNativeZoomIcons, 80);
                }
                return;
              }

              var zoomOutButton = zoomButtons[0];
              var zoomInButton = zoomButtons[1];

              zoomOutButton.innerHTML = '<svg class="reviewer-zoom-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="16.65" y1="16.65" x2="21" y2="21"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>';
              zoomOutButton.setAttribute('title', 'Zoom out');
              zoomOutButton.setAttribute('aria-label', 'Zoom out');

              zoomInButton.innerHTML = '<svg class="reviewer-zoom-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="16.65" y1="16.65" x2="21" y2="21"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>';
              zoomInButton.setAttribute('title', 'Zoom in');
              zoomInButton.setAttribute('aria-label', 'Zoom in');
            }

            setupNativeZoomIcons();

            var app = root.__wpdMinimalApp;
            var editable = root.dataset.reviewEditable === 'true';
            var initialPoints = JSON.parse(root.dataset.reviewPoints);
            var version = root.dataset.reviewVersion === '' ? null : Number(root.dataset.reviewVersion);
            var feedback = document.querySelector('[data-review-feedback]');
            var saveButton = root.querySelector('[data-review-save]');
            var decisionButtons = root.querySelectorAll('[data-review-decision] button');
            var ready = false;
            var saving = false;
            var dirty = false;
            var originalDrawPoint = app.drawPoint;
            var originalRenderZoom = app.renderZoom;
            app.setMarkerColor('#ef4444');

            app.drawPoint = function(ctx, point) {
              var color = this.markerColor;
              if (point.source_id == null) this.markerColor = '#2563eb';
              originalDrawPoint.call(this, ctx, point);
              this.markerColor = color;
            };
            app.renderZoom = function() {
              originalRenderZoom.call(this);
              var canvas = this.elements.zoomCanvas;
              var ctx = this.elements.zoomCtx;
              if (!canvas || !ctx || !this.image || !this.hoverImagePoint) return;
              var size = 40;
              var sx = Math.max(0, Math.min(this.image.width - size, this.hoverImagePoint.x - size / 2));
              var sy = Math.max(0, Math.min(this.image.height - size, this.hoverImagePoint.y - size / 2));
              this.points.forEach(function(point) {
                if (point.source_id != null || point.x < sx || point.y < sy || point.x > sx + size || point.y > sy + size) return;
                ctx.save();
                ctx.beginPath();
                ctx.fillStyle = '#2563eb';
                ctx.strokeStyle = '#fff';
                ctx.lineWidth = 1.5;
                ctx.arc((point.x - sx) * canvas.width / size, (point.y - sy) * canvas.height / size, 10, 0, Math.PI * 2);
                ctx.fill();
                ctx.stroke();
                ctx.restore();
              });
            };

            function updateCounts() {
              root.querySelector('[data-review-count]').textContent = app.points.length;
              var added = root.querySelector('[data-review-added]');
              var removed = root.querySelector('[data-review-removed]');
              if (added && removed) {
                added.textContent = app.points.filter(function(point) { return point.source_id == null; }).length;
                var remaining = app.points.filter(function(point) { return point.source_id != null; }).length;
                var baseline = Number(root.dataset.reviewOriginalCount);
                removed.textContent = baseline - remaining;
              }
            }

            function setBusy(busy) {
              saving = busy;
              if (saveButton) saveButton.disabled = busy || !ready;
              decisionButtons.forEach(function(button) { button.disabled = busy || !ready; });
            }

            function loaded() {
              if (app.points.length !== initialPoints.length || app.points.some(function(point, index) {
                return point.x !== Number(initialPoints[index].x) || point.y !== Number(initialPoints[index].y);
              })) {
                feedback.textContent = 'As marcações mudaram. Atualize a página antes de editar.';
                return;
              }
              app.points.forEach(function(point, index) {
                point.source_id = initialPoints[index].source_id;
              });
              app.render();
              updateCounts();
              if (!editable) {
                ready = true;
                return;
              }
              var token = document.querySelector('meta[name="csrf-token"]');
              fetch(root.dataset.reviewClaimUrl, {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json', 'X-CSRF-Token': token ? token.content : '' }
              }).then(function(response) {
                return response.json().then(function(body) {
                  if (!response.ok) throw new Error(body.error || 'Erro ao iniciar revisão.');
                  if (body.points.length !== initialPoints.length || body.points.some(function(point, index) {
                    var expected = initialPoints[index];
                    return Number(point.x) !== Number(expected.x) || Number(point.y) !== Number(expected.y) ||
                      point.source_id !== expected.source_id;
                  })) {
                    throw new Error('As marcações mudaram. Atualize a página antes de editar.');
                  }
                  version = body.version;
                  ready = true;
                  setBusy(false);
                  feedback.textContent = 'Clique para marcar; selecione Apagar para remover pontos. Salve antes de sair.';
                });
              }).catch(function(error) {
                feedback.textContent = 'Não foi possível iniciar a revisão: ' + error.message;
              });
            }

            root.addEventListener('wpd:points:loaded', loaded, { once: true });
            root.addEventListener('wpd:points:load-error', function() {
              feedback.textContent = 'Não foi possível carregar as marcações. Atualize a página.';
            });
            if (app.lastLoadedPointsPayload) loaded();

            root.addEventListener('click', function(event) {
              if (event.target !== app.elements.canvas) return;
              if (!editable || !ready || saving) {
                event.preventDefault();
                event.stopPropagation();
              }
            }, true);

            function markPointsChanged() {
              dirty = true;
              updateCounts();
              feedback.textContent = 'Alterações não salvas.';
            }

            root.addEventListener('click', function(event) {
              if (event.target !== app.elements.canvas || !editable || !ready || saving) return;
              markPointsChanged();
            });

            root.addEventListener('wpd:before-alternate-point', function(event) {
              if (!editable || !ready || saving) event.preventDefault();
            });

            root.addEventListener('wpd:alternate-point-changed', markPointsChanged);
            function savePoints() {
              setBusy(true);
              feedback.textContent = 'Salvando correções...';
              var token = document.querySelector('meta[name="csrf-token"]');
              return fetch(root.dataset.reviewSaveUrl, {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json', 'Content-Type': 'application/json', 'X-CSRF-Token': token ? token.content : '' },
                body: JSON.stringify({
                  version: version,
                  points: app.points.map(function(point) {
                    return { x: Number(point.x.toFixed(2)), y: Number(point.y.toFixed(2)), source_id: point.source_id == null ? null : point.source_id };
                  })
                })
              }).then(function(response) {
                return response.json().then(function(body) {
                  if (!response.ok) throw new Error(body.error || 'Erro ao salvar correções.');
                  version = body.version;
                  dirty = false;
                  feedback.textContent = 'Correções salvas.';
                });
              }).catch(function(error) {
                feedback.textContent = 'Não foi possível salvar: ' + error.message;
                throw error;
              }).finally(function() { setBusy(false); });
            }

            if (editable) {
              saveButton.addEventListener('click', function() { savePoints().catch(function() {}); });
              root.querySelectorAll('[data-review-decision]').forEach(function(form) {
                form.addEventListener('submit', function(event) {
                  event.preventDefault();
                  if (!ready || saving) return;
                  savePoints().then(function() {
                    var versionInput = document.createElement('input');
                    versionInput.type = 'hidden';
                    versionInput.name = 'correction_version';
                    versionInput.value = String(version);
                    form.appendChild(versionInput);
                    form.submit();
                  }).catch(function() {});
                });
              });
              function warnBeforeUnload(event) {
                if (!dirty) return;
                event.preventDefault();
                event.returnValue = '';
              }
              function warnBeforeVisit(event) {
                if (dirty && !window.confirm('Há alterações não salvas. Deseja sair mesmo assim?')) event.preventDefault();
              }
              window.addEventListener('beforeunload', warnBeforeUnload);
              document.addEventListener('turbo:before-visit', warnBeforeVisit);
              document.addEventListener('turbo:before-cache', function() {
                window.removeEventListener('beforeunload', warnBeforeUnload);
                document.removeEventListener('turbo:before-visit', warnBeforeVisit);
              }, { once: true });
            }
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', mountReviewerReadOnlyPlot, { once: true });
          } else {
            mountReviewerReadOnlyPlot();
          }
        })();
      </script>
    <% elsif preview_available %>
      <%= image_tag preview_tile_path(@tile), class: 'img-thumbnail', style: 'max-width: 100%; max-height: 520px;' %>
    <% else %>
      <span class="text-muted">Sem preview disponível</span>
    <% end %>

  </div>
</div>