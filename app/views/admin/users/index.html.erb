<% content_for :title, 'Gerenciamento de Usuários' %>

<div class="d-flex justify-content-between align-items-center page-header">
  <div>
    <h1 class="page-title">Gerenciamento de Usuários</h1>
    <p class="text-muted mb-0">
      <% if current_user.admin? %>
        Visualize os usuários cadastrados, altere papéis e bloqueie/desbloqueie acessos.
      <% else %>
        Consulte os anotadores cadastrados e seus dados.
      <% end %>
    </p>
  </div>
</div>

<% task_categories = [
  [:in_review, 'Em revisão', '#5b7fa6'],
  [:approved, 'Aprovadas', '#6cbf8d'],
  [:returned, 'Devolvidas', '#c56b75'],
  [:payment_requested, 'Pagamento solicitado', '#2f7d57'],
  [:paid, 'Pagas', '#14532d']
] %>
<div class="d-flex flex-wrap gap-3 small mb-3" aria-label="Legenda das tarefas">
  <% task_categories.each do |_, label, color| %>
    <span><span class="badge me-1" style="background-color: <%= color %>;">&nbsp;</span><%= label %></span>
  <% end %>
</div>

<div class="card shadow-sm border-0">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Nome</th>
            <th>E-mail</th>
            <th>Papel</th>
            <th>Status</th>
            <th>Cadastrado em</th>
            <th>Tarefas por status</th>
            <th class="text-end"><%= current_user.admin? ? 'Ações' : 'Perfil' %></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr id="user-<%= user.id %>">
              <td>
                <strong>
                  <% if current_user.finance? %>
                    <%= link_to user.name, admin_user_path(user) %>
                  <% else %>
                    <%= user.name %>
                  <% end %>
                </strong>
                <% if user == current_user %>
                  <span class="badge text-bg-secondary ms-1">Você</span>
                <% end %>
              </td>
              <td><%= user.email %></td>
              <td>
                <span class="badge text-bg-light border text-dark"><%= user_role_label(user.role) %></span>
              </td>
              <td>
                <% if user.blocked? %>
                  <span class="badge text-bg-danger">Bloqueado</span>
                <% else %>
                  <span class="badge text-bg-success">Ativo</span>
                <% end %>
              </td>
              <td><%= user.created_at.strftime('%d/%m/%Y %H:%M') %></td>
              <td style="min-width: 240px;">
                <% counts = @task_status_counts[user.id] || {} %>
                <% total = task_categories.sum { |category, _, _| counts.fetch(category, 0) } %>
                <% if total.positive? %>
                  <div class="progress" aria-label="Distribuição de <%= total %> tarefas">
                    <% task_categories.each do |category, label, color| %>
                      <% count = counts.fetch(category, 0) %>
                      <% if count.positive? %>
                        <div class="progress-bar" role="img" aria-label="<%= label %>: <%= count %>"
                             title="<%= label %>: <%= count %>"
                             style="background-color: <%= color %>; width: <%= (count * 100.0 / total).round(6) %>%;"></div>
                      <% end %>
                    <% end %>
                  </div>
                <% else %>
                  <div class="text-muted small">Nenhuma tarefa</div>
                <% end %>
                <div class="d-flex flex-wrap gap-2 mt-1 small">
                  <% task_categories.each do |category, label, color| %>
                    <span aria-label="<%= label %>: <%= counts.fetch(category, 0) %>" title="<%= label %>"
                          class="text-dark fw-semibold"><span aria-hidden="true" style="color: <%= color %>;">&#9632;</span> <%= counts.fetch(category, 0) %></span>
                  <% end %>
                </div>
              </td>
              <td class="text-end">
                <% if current_user.admin? %>
                  <% if user == current_user %>
                    <span class="text-muted small">Não disponível para seu próprio usuário</span>
                  <% else %>
                    <div class="d-flex justify-content-end gap-2 flex-wrap">
                      <%= form_with url: update_role_admin_user_path(user), method: :patch, local: true, class: 'd-flex gap-2' do %>
                        <%= select_tag :role,
                                       options_for_select([
                                         ['Administrador', 'admin'],
                                         ['Financeiro', 'finance'],
                                         ['Uploader', 'uploader'],
                                         ['Anotador', 'annotator'],
                                         ['Revisor', 'reviewer']
                                       ], user.role),
                                       class: 'form-select form-select-sm' %>
                        <%= submit_tag 'Salvar', class: 'btn btn-sm btn-outline-primary' %>
                      <% end %>

                      <% if user.blocked? %>
                        <%= button_to 'Desbloquear',
                                      toggle_block_admin_user_path(user),
                                      method: :patch,
                                      class: 'btn btn-sm btn-outline-success',
                                      form: {
                                        data: {
                                          turbo_confirm: "Tem certeza que deseja desbloquear #{user.name}?"
                                        }
                                      } %>
                      <% else %>
                        <%= button_to 'Bloquear',
                                      toggle_block_admin_user_path(user),
                                      method: :patch,
                                      class: 'btn btn-sm btn-outline-danger',
                                      form: {
                                        data: {
                                          turbo_confirm: "Tem certeza que deseja bloquear #{user.name}?"
                                        }
                                      } %>
                      <% end %>
                    </div>
                  <% end %>
                <% else %>
                  <%= link_to 'Ver perfil',
                              admin_user_path(user),
                              class: 'btn btn-sm btn-outline-primary' %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if @users.respond_to?(:current_page) %>
  <div class="d-flex justify-content-center mt-3">
    <%= paginate @users %>
  </div>
<% end %>
