<% content_for :title, "Usuário: #{@user.name}" %>

<div class="d-flex justify-content-between align-items-center page-header">
  <div>
    <h1 class="page-title">Dados do Usuário</h1>
    <p class="text-muted mb-0">Detalhes de cadastro e pagamento do usuário selecionado.</p>
  </div>
  <% if current_user.admin? %>
    <%= link_to 'Voltar para usuários', admin_users_path, class: 'btn btn-outline-secondary btn-sm' %>
  <% else %>
    <div class="d-flex gap-2">
      <%= link_to 'Voltar para usuários', admin_users_path, class: 'btn btn-outline-secondary btn-sm' %>
      <%= link_to 'Voltar para pagamentos', admin_payments_path, class: 'btn btn-outline-secondary btn-sm' %>
    </div>
  <% end %>
</div>

<div class="card shadow-sm border-0">
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-6">
        <div class="small text-muted">Nome</div>
        <div class="fw-semibold"><%= @user.name %></div>
      </div>

      <div class="col-md-6">
        <div class="small text-muted">E-mail</div>
        <div><%= @user.email %></div>
      </div>

      <div class="col-md-4">
        <div class="small text-muted">Papel</div>
        <div><span class="badge text-bg-light border text-dark"><%= user_role_label(@user.role) %></span></div>
      </div>

      <div class="col-md-4">
        <div class="small text-muted">Status</div>
        <div>
          <% if @user.blocked? %>
            <span class="badge text-bg-danger">Bloqueado</span>
          <% else %>
            <span class="badge text-bg-success">Ativo</span>
          <% end %>
        </div>
      </div>

      <div class="col-md-4">
        <div class="small text-muted">Cadastrado em</div>
        <div><%= @user.created_at.strftime('%d/%m/%Y %H:%M') %></div>
      </div>

      <div class="col-md-6">
        <div class="small text-muted">Login USP</div>
        <div><%= @user.usp_login.presence || '-' %></div>
      </div>

      <div class="col-md-6">
        <div class="small text-muted">CPF</div>
        <div><%= @user.cpf.presence || '-' %></div>
      </div>

      <div class="col-md-6">
        <div class="small text-muted">Telefone</div>
        <div><%= @user.phone.presence || '-' %></div>
      </div>

      <div class="col-md-6">
        <div class="small text-muted">Tipo de chave PIX</div>
        <div><%= @user.pix_key_type.presence || '-' %></div>
      </div>

      <div class="col-12">
        <div class="small text-muted">Chave PIX</div>
        <div><%= @user.pix_key.presence || '-' %></div>
      </div>

      <div class="col-md-6">
        <div class="small text-muted">Pagamento solicitado</div>
        <div><%= number_to_currency(@user.requested_payment_reais, unit: 'R$', separator: ',', delimiter: '.', format: '%u%n') %></div>
      </div>

      <div class="col-md-6">
        <div class="small text-muted">Solicitado em</div>
        <div><%= @user.requested_payment_at ? @user.requested_payment_at.strftime('%d/%m/%Y %H:%M') : '-' %></div>
      </div>
    </div>
  </div>
</div>

<% if current_user.finance? %>
  <div class="card shadow-sm border-0 mt-4">
    <div class="card-body">
      <h2 class="h5 mb-3">Tarefas executadas</h2>
      <p class="text-muted small">Uma linha por imagem, com seu status atual.</p>
      <% if @tasks.any? %>
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead>
              <tr><th>ID</th><th>Arquivo</th><th>Status atual</th><th class="text-end">Valor</th></tr>
            </thead>
            <tbody>
              <% @tasks.each do |tile| %>
                <tr>
                  <td><%= tile.id %></td>
                  <td><%= tile.original_filename %></td>
                  <td><%= human_tile_status(tile.status) %></td>
                  <td class="text-end">
                    <% amount = if tile.paid? && tile.payment_item&.payment&.annotator_id == @user.id
                                  tile.payment_item.amount
                                else
                                  tile.task_value
                                end %>
                    <%= amount.nil? ? '-' : number_to_currency(amount, unit: 'R$', separator: ',', delimiter: '.', format: '%u%n') %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <% if @tasks.respond_to?(:current_page) %>
          <div class="d-flex justify-content-center mt-3"><%= paginate @tasks %></div>
        <% end %>
      <% else %>
        <p class="text-muted mb-0">Nenhuma tarefa encontrada.</p>
      <% end %>
    </div>
  </div>
<% end %>

<%= render 'shared/payments_history', user: @user %>
