<% paid_tiles = Image.paid_tiles_for_annotator(user).to_a %>
<div class="card shadow-sm border-0 mt-4">
  <div class="card-body">
    <h2 class="h5 mb-3">Pagamentos efetuados</h2>
    <% if paid_tiles.empty? %>
      <p class="text-muted mb-0">Nenhum pagamento efetuado.</p>
    <% else %>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr><th>Tile</th><th>Pago em</th><th class="text-end">Valor</th></tr>
          </thead>
          <tbody>
            <% paid_tiles.each do |tile| %>
              <tr>
                <td>#<%= tile.id %></td>
                <td><%= tile.updated_at.strftime('%d/%m/%Y %H:%M') %></td>
                <td class="text-end"><%= number_to_currency(tile.task_value, unit: 'R$', separator: ',', delimiter: '.', format: '%u%n') %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr class="fw-semibold">
              <td colspan="2">Total pago</td>
              <td class="text-end"><%= number_to_currency(paid_tiles.sum { |t| t.task_value.to_d }, unit: 'R$', separator: ',', delimiter: '.', format: '%u%n') %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% end %>
  </div>
</div>
