<% payments = user.payments.order(paid_at: :desc) %>
<div class="card shadow-sm border-0 mt-4">
  <div class="card-body">
    <h2 class="h5 mb-3">Pagamentos efetuados</h2>
    <% if payments.empty? %>
      <p class="text-muted mb-0">Nenhum pagamento registrado.</p>
    <% else %>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead>
            <tr><th>Pagamento</th><th>Pago em</th><th class="text-end">Valor</th></tr>
          </thead>
          <tbody>
            <% payments.each do |payment| %>
              <tr>
                <td><%= link_to "Pagamento ##{payment.id}", payment_path(payment) %></td>
                <td><%= payment.paid_at.strftime('%d/%m/%Y %H:%M') %></td>
                <td class="text-end"><%= number_to_currency(payment.amount, unit: 'R$', separator: ',', delimiter: '.', format: '%u%n') %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr class="fw-semibold">
              <td colspan="2">Total pago</td>
              <td class="text-end"><%= number_to_currency(payments.sum(&:amount), unit: 'R$', separator: ',', delimiter: '.', format: '%u%n') %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% end %>
  </div>
</div>
